Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Stage1 (sin curb)
      Enabled: true
      Topic:
        Value: /goose_stage1
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Size (Pixels): 3
      Size (m): 0.05
      Style: Points
      Use Fixed Frame: true
      Use rainbow: false
      Color Transformer: RGB8
    - Class: rviz_default_plugins/PointCloud2
      Name: Con Curb Detection
      Enabled: true
      Topic:
        Value: /goose_curb
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Size (Pixels): 3
      Size (m): 0.05
      Style: Points
      Use Fixed Frame: true
      Use rainbow: false
      Color Transformer: RGB8
    - Class: rviz_default_plugins/PointCloud2
      Name: Curb GT (cyan=det, magenta=miss)
      Enabled: true
      Topic:
        Value: /goose_curb_gt
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Size (Pixels): 5
      Size (m): 0.15
      Style: Points
      Use Fixed Frame: true
      Use rainbow: false
      Color Transformer: RGB8
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 50
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.5
      Yaw: 3.14
      Target Frame: map
